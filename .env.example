# ── Required in production (see DEPLOY.md for the free setup) ──
DATABASE_URL=                  # Supabase "Session pooler" URI. Leave empty locally to use the embedded Postgres in ./data/pg
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
CRON_SECRET=                   # openssl rand -hex 24 (protects /api/cron/ingest)

# ── Email: alerts + password resets. Empty = printed to the server log ──
SMTP_USER=                     # free: a Gmail address
SMTP_PASS=                     # its App Password (myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com     # defaults shown; change for other SMTP providers
# SMTP_PORT=465
# RESEND_API_KEY=              # alternative to SMTP once you own a domain
# EMAIL_FROM="SourceFirst <alerts@yourdomain.com>"

# ── Optional ──
HEALTHCHECK_URL=               # healthchecks.io ping URL: emails you if crawls stop
GOOGLE_CLIENT_ID=              # "Continue with Google"
GOOGLE_CLIENT_SECRET=
RETAIN_CLOSED_DAYS=14          # how long closed jobs stay before being deleted (keeps the free DB small)

# ── Local scheduler (normal servers only; automatically off on Vercel) ──
LOCAL_CRON=1
CRAWL_INTERVAL_MINUTES=15
